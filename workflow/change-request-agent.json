      "id": "56bba369-847c-4a48-933a-30f84b6f4a26",
      "name": "Modell Trennung (Gemini 2.5 Flash)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        1576,
        232
      ],
      "credentials": {
        "openRouterApi": {
