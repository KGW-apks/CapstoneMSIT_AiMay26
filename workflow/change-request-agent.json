    {
      "parameters": {
        "jsCode": "// Kunde bestimmen und Eingang normalisieren. Die Kunden-ID kommt nie vom Modell: bei Mails aus der Absenderadresse (erst genaue Adresse, dann Domain),\n// beim Webhook-Test aus dem Body (kundeId oder absender). In beiden Fällen gilt sie nur, wenn sie im Kundenstamm steht, sonst bleibt kundeId leer (Ablehnung).\n// Kundenstamm: ein Tab „Kunden“, Spalte „Absender“ mit Adressen und Domains, getrennt durch Komma, Semikolon oder Zeilenumbruch.\n// ablehnungsgrund sagt, warum kein Kunde bestimmt wurde; die Ablehnung schreibt ihn ins Log.\nconst norm = s => String(s ?? '').trim();\nlet ein;\ntry {\n  ein = $('Älteste Mail wählen und aufbereiten').first().json;\n} catch (e) {\n  const w = $('Anfrage per Webhook (Test)').first().json;\n  const b = w.body ?? w;\n  ein = { ticketId: b.ticketId, kundeId: b.kundeId, quelle: b.quelle, anfrage: b.anfrage, absender: b.absender, mailId: b.mailId };\n}\nconst kunden = $input.all().map(i => i.json).filter(r => norm(r['Kunden-ID']) !== '');\nconst absender = kunden.flatMap(r => String(r['Absender'] ?? '').split(/[,;\\n]/).map(norm).filter(Boolean)\n  .map(eintrag => ({ eintrag: eintrag.toLowerCase(), id: norm(r['Kunden-ID']).toUpperCase() })));\nconst adresse = norm(ein.absender).toLowerCase();\nconst domain = adresse.split('@')[1] ?? '';\nlet id = '';\nlet anfrage = String(ein.anfrage ?? '');\nlet grund = '';\nif (norm(ein.kundeId)) {\n  id = norm(ein.kundeId).toUpperCase();\n} else if (adresse) {\n  const genau = absender.find(a => a.eintrag.includes('@') && !a.eintrag.startsWith('@') && a.eintrag === adresse);\n  const dom = absender.find(a => { const d = a.eintrag.replace(/^@/, ''); return !d.includes('@') && d !== '' && (domain === d || domain.endsWith('.' + d)); });\n  const treffer = genau ?? dom;\n  id = treffer ? treffer.id : '';\n  if (!treffer) grund = 'Absender steht nicht im Kundenstamm';\n  // Eingetragene Tester (Kunden-ID TEST im Kundenstamm) nennen den Kunden im Betreff, z. B. \"[Kunde B] Fehler im Export\".\n  // Nur für Tester, damit sich kein fremder Absender über den Betreff einen Kunden aussucht. Die Kennung wird entfernt, das Modell sieht den Kunden nicht.\n  if (id === 'TEST') {\n    const kennung = /\\[\\s*Kunde\\s+([A-Za-z0-9]+)\\s*\\]\\s*/i;\n    const m = anfrage.split('\\n')[0].match(kennung);\n    id = m ? m[1].toUpperCase() : '';\n    if (m) anfrage = anfrage.replace(kennung, '');\n    else grund = 'Tester ohne [Kunde X] im Betreff';\n  }\n} else {\n  grund = 'Weder Absender noch Kunden-ID angegeben';\n}\nconst k = kunden.find(r => norm(r['Kunden-ID']).toUpperCase() === id);\nconst dateiId = k ? norm(k['Vertragsdatei-ID']) : '';\nconst kontingentTab = k ? norm(k['Kontingent-Tab']) : '';\nconst ok = id !== 'TEST' && Boolean(k) && dateiId !== '' && kontingentTab !== '';\nif (!ok && !grund) grund = k ? 'Kunde ' + id + ' im Kundenstamm unvollständig (Vertragsdatei oder Kontingent-Tab fehlt)' : 'Kunde ' + id + ' steht nicht im Kundenstamm';\nreturn [{ json: {\n  ticketId: norm(ein.ticketId) || ('AUTO-' + $execution.id),\n  kundeId: ok ? id : '',\n  quelle: norm(ein.quelle) || 'Test',\n  anfrage,\n  mailId: norm(ein.mailId),\n  dateiId: ok ? dateiId : '',\n  kontingentTab: ok ? kontingentTab : '',\n  ablehnungsgrund: ok ? '' : grund\n}, pairedItem: { item: 0 } }]; // ohne Zuordnung liefert $('…').first() in späteren Knoten nichts (Lauf 611)\n"
      },
      "id": "30b5bbae-2743-47d8-bfc6-136e0a7ef000",
      "name": "Kunde bestimmen und Eingang normalisieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        400
      ],
      "onError": "continueErrorOutput"
    },
