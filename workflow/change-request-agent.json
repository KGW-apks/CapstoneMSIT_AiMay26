    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"anliegen\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"text\": { \"type\": \"string\" }\n        },\n        \"required\": [\"text\"]\n      }\n    }\n  },\n  \"required\": [\"anliegen\"]\n}"
      },
      "id": "9e183188-6adb-4ebf-8566-4d7b0a806c0b",
      "name": "Format Trennung",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1704,
        232
      ]
    },
    {
      "parameters": {
        "jsCode": "// Aus der Trennung durch das Modell werden einzelne Anliegen, je Anliegen ein Item für den Sub-Workflow „Capstone Anliegen bearbeiten“.\n// Jedes Anliegen muss wörtlich im geschwärzten Text stehen. Sonst, bei einem Fehler des Modells oder mehr als 5 Teilen,\n// wird die Mail wie vor der Trennung als ein Anliegen bearbeitet und der Grund als trennHinweis ins Protokoll gegeben.\nconst MAX_TEILE = 5;\nconst norm = s => String(s ?? '').toLowerCase().replace(/[„“”\"«»]/g, '\"').replace(/[‚‘’']/g, \"'\").replace(/\\s+/g, ' ').trim();\nconst ein = $('Kunde bestimmen und Eingang normalisieren').first(0).json;\nconst gs = $('Geschwärzten Text übernehmen').first().json;\nconst ganz = String(gs.anfrageGeschwaerzt ?? '');\nconst roh = $input.first().json;\nconst liste = roh.output?.anliegen;\nlet teile = [ganz];\nlet hinweis = '';\nif (roh.error) {\n  hinweis = 'Trennung fehlgeschlagen, Mail als ein Anliegen bearbeitet';\n} else if (!Array.isArray(liste) || liste.length === 0) {\n  hinweis = 'Trennung ohne Ergebnis, Mail als ein Anliegen bearbeitet';\n} else if (liste.length > MAX_TEILE) {\n  hinweis = 'Mehr als ' + MAX_TEILE + ' Anliegen erkannt, Mail als ein Anliegen bearbeitet';\n} else if (liste.length > 1) {\n  const texte = liste.map(a => String(a?.text ?? '').trim());\n  const fremd = texte.filter(t => t === '' || !norm(ganz).includes(norm(t)));\n  if (fremd.length > 0) hinweis = 'Anliegen nicht wörtlich im Text, Mail als ein Anliegen bearbeitet';\n  else teile = texte;\n}\nconst n = teile.length;\nreturn teile.map((text, i) => ({ json: {\n  ticketId: n > 1 ? ein.ticketId + '-' + (i + 1) : ein.ticketId,\n  kundeId: ein.kundeId,\n  quelle: ein.quelle,\n  mailId: ein.mailId,\n  dateiId: ein.dateiId,\n  kontingentTab: ein.kontingentTab,\n  anfrage: ein.anfrage,\n  anfrageGeschwaerzt: text,\n  guardrailTreffer: gs.guardrailTreffer ?? '',\n  teilNr: i + 1,\n  teileGesamt: n,\n  trennHinweis: hinweis\n}, pairedItem: { item: 0 } }));\n"
      },
