      "id": "2e06eb9a-782c-42ad-b2b0-880fa1e1fa8d",
      "name": "Mail verschieben",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [
        2816,
        352
      ],
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "",
          "name": "Microsoft Outlook account"
        }
