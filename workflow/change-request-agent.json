    {
      "parameters": {
        "jsCode": "// Mail aus dem Ordner Agent in das Eingangsformat bringen. Die Kunden-ID wird erst danach im Kundenstamm nachgeschlagen.\n// Der Outlook-Knoten liefert bis zu 25 Mails ohne feste Reihenfolge; verarbeitet wird die älteste, damit der Ordner der Reihe nach abläuft.\n// Eine Mail pro Lauf: die Nodes danach lesen mit .first() und setzen genau einen Fall voraus.\n// shortcut: nur die ersten 25 Mails des Ordners werden verglichen, bei größerem Rückstau eine sortierte Abfrage nachrüsten.\nconst m = $input.all().map(i => i.json).reduce((a, b) => (String(b.receivedDateTime ?? '') < String(a.receivedDateTime ?? '') ? b : a));\nconst betreff = String(m.subject ?? '');\nconst roh = String(m.body?.content ?? m.bodyPreview ?? '');\nconst istHtml = String(m.body?.contentType ?? '').toLowerCase() === 'html' || /<[a-z][\\s\\S]*>/i.test(roh);\nconst text = istHtml\n  ? roh.replace(/<style[\\s\\S]*?<\\/style>/gi, ' ').replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n      .replace(/<br\\s*\\/?>|<\\/p>|<\\/div>|<\\/tr>|<\\/li>/gi, '\\n').replace(/<[^>]+>/g, ' ')\n      .replace(/&nbsp;/g, ' ').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").replace(/&amp;/g, '&')\n  : roh;\nconst anfrage = (betreff + '\\n\\n' + text).replace(/[ \\t]+/g, ' ').replace(/\\n\\s*\\n+/g, '\\n\\n').trim();\nconst absender = String(m.from?.emailAddress?.address ?? m.sender?.emailAddress?.address ?? '').toLowerCase();\nreturn [{ json: { anfrage, absender, quelle: 'Outlook', mailId: m.id } }];"
      },
      "id": "fa8894ce-6c9e-480d-bf85-602c33f9b803",
