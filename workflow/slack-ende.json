        "text": "={{ (() => { const k = $('Freigabekarte aufbereiten').first().json; const r = $('Slack: Freigabe durch Projektleitung').first().json.data?.responder; return 'Freigegeben, bitte umsetzen: Ticket ' + k.ticketId + ' (Kunde ' + k.kundeId + ')\\n' + 'Einordnung: ' + (k.urteil ?? '-') + (k.kategorie ? ', Kategorie ' + k.kategorie : '') + '\\n' + 'Fundstelle: ' + (k.fundstelle ?? '-') + '\\n' + 'Kontingent: ' + (k.kontingentText || '-') + '\\n' + 'Freigabe durch: ' + (r?.name ?? r?.id ?? 'unbekannt') + '\\n\\n' + 'Originalmail:\\n' + k.anfrage; })() }}",
