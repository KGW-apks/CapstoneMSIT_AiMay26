    {
      "id": "32398946-3d4a-43b0-90b8-18c451043c3e",
      "name": "Freigabekarte aufbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        608
      ],
      "parameters": {
        "jsCode": "// Eine Slack-Karte für Eskalation, unsichere Klassifikation und Zusatzleistung.\n// Neues Angebot (Kategorie B oder C, Urteil Zusatzleistung): nach der Freigabe geht der Fall an den Vertrieb.\nconst j = $input.first().json;\nconst vertrieb = j.urteil === 'zusatzleistung' && ['B', 'C'].includes(j.kategorie);\nconst zeilen = [\n  'Freigabe nötig: Ticket ' + j.ticketId + ' (Kunde ' + j.kundeId + ')',\n  'Einordnung des Systems: ' + (j.urteil ?? 'keine') + (j.kategorie ? ', Kategorie ' + j.kategorie : '') + (j.sicherheit != null ? ', Sicherheit ' + j.sicherheit : ''),\n  'Anlass: ' + (j.grund || 'Zusatzleistung'),\n  'Begründung: ' + (j.begruendung ?? '-'),\n  'Fundstelle: ' + (j.fundstelle ?? '-') + (j.zitatOk === true ? ' (Zitat im Vertrag belegt)' : j.zitatOk === false ? ' (Zitat NICHT belegt)' : ''),\n  'Kontingent: ' + (j.kontingentText || '-'),\n  '',\n  'Originalmail:',\n  j.anfrage\n];\nreturn [{ json: { ...j, vertrieb, slackText: zeilen.join('\\n') } }];\n"
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "sendAndWait",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#anfragen_review"
        },
        "message": "={{ $json.slackText }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Freigeben",
            "disapproveLabel": "Ablehnen"
          }
        },
        "captureResponder": true,
        "options": {
          "limitWaitTime": {
            "values": {
              "resumeAmount": 8
            }
          }
        }
      },
