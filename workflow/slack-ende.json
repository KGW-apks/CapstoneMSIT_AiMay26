    {
      "id": "32398946-3d4a-43b0-90b8-18c451043c3e",
      "name": "Freigabekarte aufbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        608
      ],
      "parameters": {
        "jsCode": "// Eine Slack-Karte für Eskalation, unsichere Klassifikation und Zusatzleistung.\n// Neues Angebot (Kategorie B oder C, Urteil Zusatzleistung): Vorschlag des Systems ist der Vertrieb, sonst der Senior. Die Projektleitung entscheidet im Formular.\nconst j = $input.first().json;\nconst vertrieb = j.urteil === 'zusatzleistung' && ['B', 'C'].includes(j.kategorie);\nconst zeilen = [\n  'Freigabe nötig: Ticket ' + j.ticketId + ' (Kunde ' + j.kundeId + ')',\n  'Klasse der Anfrage: ' + (j.klasse || '-') + (j.klasseBegruendung ? ' (' + j.klasseBegruendung + ')' : ''),\n  'Einordnung des Systems: ' + (j.urteil ?? 'keine') + (j.kategorie ? ', Kategorie ' + j.kategorie : '') + (j.sicherheit != null ? ', Sicherheit ' + j.sicherheit : ''),\n  'Vorschlag des Systems: ' + (vertrieb ? 'An Vertrieb (neues Angebot)' : 'An Senior'),\n  'Anlass: ' + (j.grund || 'Zusatzleistung'),\n  'Begründung: ' + (j.begruendung ?? '-'),\n  'Fundstelle: ' + (j.fundstelle ?? '-') + (j.zitatOk === true ? ' (Zitat im Vertrag belegt)' : j.zitatOk === false ? ' (Zitat NICHT belegt)' : ''),\n  'Kontingent: ' + (j.kontingentText || '-'),\n  ...(j.kundenfreigabeText ? ['Kundenfreigabe: ' + j.kundenfreigabeText] : []),\n  '',\n  'Originalmail:',\n  j.anfrage\n];\nreturn [{ json: { ...j, vertrieb, slackText: zeilen.join('\\n') } }];\n"
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "sendAndWait",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#anfragen_review"
        },
        "message": "={{ (() => { try { return $json.slackText; } catch (e) { return 'Freigabe nötig. Die Details stehen in der Slack-Karte, von der du gekommen bist.'; } })() }}",
        "responseType": "customForm",
        "defineForm": "fields",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Entscheidung",
              "fieldType": "radio",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Ablehnen"
                  },
                  {
                    "option": "An Senior"
                  },
                  {
                    "option": "An Vertrieb"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Name",
              "fieldType": "text",
              "placeholder": "Wer entscheidet?",
              "requiredField": true
            },
            {
              "fieldLabel": "Begründung",
              "fieldType": "textarea",
              "requiredField": false
            }
          ]
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 8,
              "resumeUnit": "hours"
            }
          },
          "messageButtonLabel": "Entscheiden",
          "responseFormTitle": "Freigabe durch die Projektleitung",
          "responseFormButtonLabel": "Absenden"
        }
      },
      "id": "60c464e1-506f-4f83-8f80-2c50b0ef6c66",
      "name": "Slack: Freigabe anfragen in #anfragen_review",
